{
  "name": "canvas-scribe",
  "version": "0.1.0",
  "description": "Pen-first handwriting directly on Obsidian Canvas.",
  "main": "main.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheFurnace/canvas-scribe.git"
  },
  "bugs": {
    "url": "https://github.com/TheFurnace/canvas-scribe/issues"
  },
  "homepage": "https://github.com/TheFurnace/canvas-scribe#readme",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "check:versions": "node scripts/check-versions.mjs",
    "check": "pnpm check:versions && pnpm build && pnpm test",
    "deploy:vault": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-vault.ps1",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1"
  },
  "keywords": [
    "obsidian",
    "canvas",
    "handwriting",
    "stylus",
    "s-pen"
  ],
  "license": "MIT",
  "dependencies": {
    "perfect-freehand": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
